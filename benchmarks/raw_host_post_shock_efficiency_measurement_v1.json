{
  "schema": "aurora-raw-host-post-shock-efficiency-measurement-v1",
  "purpose": "confirmatory-post-shock-efficiency-study",
  "unit_of_randomization": "complete-block",
  "unit_of_analysis": "paired-complete-block-contrast",
  "clock_relationship": "independent-unsynchronized-steady-clocks",
  "deadline_evaluation": {
    "clock": "receiver-steady",
    "origin": "first-accepted-authenticated-descriptor-receipt",
    "duration_source": "authenticated-descriptor-relative-deadline",
    "sender_expiry_values_used": false
  },
  "windows": {
    "pre_shock_generation_indices": [0, 1],
    "imposed_shock_generation_index": 2,
    "post_shock_generation_indices": [3, 4, 5, 6, 7],
    "shock_included_in_primary_outcome": false
  },
  "primary_outcome": {
    "id": "post-shock-wire-symbol-datagrams-over-scheduled-generations",
    "definition": "sum over generation indices 3 through 7 of initial_symbols plus repair_symbols_emitted",
    "denominator": "five-prescheduled-post-shock-generations",
    "missing_or_failed_generations": "retained in the denominator and analysis",
    "lower_is_better": true,
    "primary_contrast": "biological-adaptive-minus-fixed-class-aware"
  },
  "delivery_guardrail": {
    "outcome": "critical-delivery-before-receiver-deadline",
    "scope": "all five post-shock generations in both treatments and every complete block",
    "rule": "any post-shock critical miss makes the efficiency interpretation inconclusive; the observation is retained"
  },
  "technical_validity": {
    "pre_shock_requirement": "generations 0 and 1 deliver completely and deliver critical data before their receiver deadlines in both treatments",
    "reason": "the imposed generation-2 failure must begin from the same successful pre-shock controller history"
  },
  "secondary_outcomes": [
    "post-shock-initial-symbols",
    "post-shock-repair-symbols-requested",
    "post-shock-repair-symbols-emitted",
    "post-shock-total-delivery",
    "whole-lifecycle-terminal-feedback-rtt-mean-us",
    "whole-lifecycle-terminal-feedback-retry-rounds",
    "per-generation-protection-factors",
    "per-generation-adaptive-state"
  ],
  "causal_adaptation_regression": {
    "condition": "regime-change-v1",
    "terminal_failure_generation_index": 2,
    "subsequent_plan_generation_index": 3,
    "biological_requirement": "the generation-3 plan reflects the updated failure state and changes at least one protection factor",
    "fixed_requirement": "all per-generation protection factors remain invariant",
    "policy_winner_targeted": false
  },
  "required_per_generation_evidence": {
    "sender": [
      "index",
      "policy_id",
      "delivered",
      "terminal_failure",
      "critical_before_deadline",
      "source_symbols",
      "initial_symbols",
      "repair_requested",
      "repair_emitted",
      "critical_protection_factor",
      "important_protection_factor",
      "elastic_protection_factor",
      "adaptive_state_present",
      "adaptive_generation_count_at_plan",
      "adaptive_success_count_at_plan",
      "adaptive_failure_count_at_plan",
      "adaptive_panic_boost_at_plan",
      "adaptive_critical_overhead_at_plan",
      "adaptive_important_overhead_at_plan",
      "adaptive_success_count_after_terminal",
      "adaptive_failure_count_after_terminal",
      "adaptive_panic_boost_after_terminal"
    ],
    "receiver": [
      "index",
      "delivered",
      "terminal_failure",
      "critical_before_deadline",
      "descriptor_received_at_ms",
      "critical_deadline_duration_ms",
      "critical_deadline_at_ms",
      "generation_deadline_duration_ms",
      "generation_deadline_at_ms",
      "deadline_clock",
      "regime_outage",
      "regime_suppressed_symbols"
    ]
  },
  "analysis": {
    "test": "two-sided-one-sample-t-on-paired-block-contrasts",
    "alpha": 0.05,
    "confidence_interval": 0.95,
    "report_each_lifecycle": true,
    "report_each_block_contrast": true,
    "superiority_test": true,
    "outcome_dependent_stopping": false,
    "adaptive_policy_is_design_target": false
  },
  "prohibitions": {
    "per-delivered-generation-denominator": true,
    "shock-generation-policy-ranking": true,
    "cross_clock_subtraction": true,
    "sender_relative_expiry_evaluation": true,
    "one_way_latency_claim": true,
    "network_only_rtt_claim": true,
    "post_hoc_workload_change": true,
    "post_hoc_trace_change": true,
    "post_hoc_policy_parameter_change": true,
    "outcome_dependent_replacement": true,
    "early_stopping_for_policy_ranking": true
  }
}
