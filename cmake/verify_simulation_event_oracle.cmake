if(NOT DEFINED EVENT_LEDGER OR NOT DEFINED DECISION_TRACE)
  message(FATAL_ERROR "simulation oracle paths are required")
endif()

file(SHA256 "${EVENT_LEDGER}" EVENT_LEDGER_SHA256)
file(SHA256 "${DECISION_TRACE}" DECISION_TRACE_SHA256)

set(EXPECTED_EVENT_LEDGER_SHA256
    "ae074b8e66356b660654ef35bc997c4121868738e2a99019569e541aeb7448b0")
set(EXPECTED_DECISION_TRACE_SHA256
    "4c99ffb05a68477f0dd9b043a0480aaff57073da2962ac40730983ec0e7f1e67")

if(NOT EVENT_LEDGER_SHA256 STREQUAL EXPECTED_EVENT_LEDGER_SHA256)
  message(FATAL_ERROR
    "simulation event ledger regression oracle changed: "
    "${EVENT_LEDGER_SHA256} != ${EXPECTED_EVENT_LEDGER_SHA256}")
endif()
if(NOT DECISION_TRACE_SHA256 STREQUAL EXPECTED_DECISION_TRACE_SHA256)
  message(FATAL_ERROR
    "decision trace regression oracle changed: "
    "${DECISION_TRACE_SHA256} != ${EXPECTED_DECISION_TRACE_SHA256}")
endif()

message(STATUS
  "simulation V7/V6 regression oracles verified: "
  "${EVENT_LEDGER_SHA256} ${DECISION_TRACE_SHA256}")
